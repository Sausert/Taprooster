# ============================================================
# WALHALLA TAPROOSTER — Environment Variables
# Kopieer dit bestand naar .env.local en vul de waarden in
# Voeg .env.local toe aan .gitignore (staat er al in)
# ============================================================

# Supabase (vind je in: Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://JOUW-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role (alleen server-side, NOOIT naar frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Resend (e-mail) — gratis account op resend.com (3.000 mails/maand gratis)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=taprooster@ojcwalhalla.nl

# App URL (lokaal: http://localhost:3000, productie: https://taprooster.ojcwalhalla.nl)
NEXT_PUBLIC_APP_URL=http://localhost:3000
